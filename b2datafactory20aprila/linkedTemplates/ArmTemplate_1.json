			"name": "[concat(parameters('factoryName'), '/transformation3')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "3_salesfiles_prop",
								"type": "DatasetReference"
							},
							"name": "sourcesales3"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "3_target_businessrquire",
								"type": "DatasetReference"
							},
							"name": "sinkreporting"
						}
					],
					"transformations": [
						{
							"name": "wherefilter3"
						},
						{
							"name": "selectcols3"
						},
						{
							"name": "countrysplit"
						},
						{
							"name": "aggregation3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          InvoiceNo as integer,",
						"          StockCode as integer,",
						"          Description as string,",
						"          Quantity as integer,",
						"          InvoiceDate as date,",
						"          UnitPrice as double,",
						"          CustomerID as integer,",
						"          Country as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourcesales3",
						"sourcesales3 filter(InvoiceNo!=537669) ~> wherefilter3",
						"wherefilter3 select(mapColumn(",
						"          InvoiceNo,",
						"          Quantity,",
						"          InvoiceDate,",
						"          UnitPrice,",
						"          CustomerID,",
						"          Country",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcols3",
						"selectcols3 split(Country=='United Kingdom',",
						"     Country=='Germany',",
						"     disjoint: false) ~> countrysplit@(UK, Germany, Other)",
						"countrysplit@UK aggregate(groupBy(InvoiceNo),",
						"     UnitPrice = sum(UnitPrice)) ~> aggregation3",
						"aggregation3 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkreporting"
					]
				}
			},
			"dependsOn": []
		},
